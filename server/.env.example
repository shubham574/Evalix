PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/evalix
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRE=7d
GEMINI_API_KEY=your-gemini-api-key
CLIENT_URL=http://localhost:5173

# ElevenLabs (primary TTS + STT; Gemini is used as fallback)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY

# Module 1: Candidate Intake & Secure Document Storage
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=./storage/private
MAX_DOCUMENT_SIZE_BYTES=5242880
DOCUMENT_SIGNED_URL_TTL_SECONDS=300
DOCUMENT_RETENTION_DAYS=90
DOCUMENT_SIGNING_SECRET=change-this-to-a-strong-random-secret
MALWARE_SCAN_ENABLED=true

# Module 2: Resume & Job Description Intelligence Engine
DOCUMENT_EXTRACTION_ENABLED=true
DOCUMENT_EXTRACTION_MAX_PAGES=30
DOCUMENT_EXTRACTION_MAX_CHARACTERS=100000
DOCUMENT_EXTRACTION_CHUNK_SIZE=12000
DOCUMENT_EXTRACTION_CHUNK_OVERLAP=800
DOCUMENT_EXTRACTION_WORKER_CONCURRENCY=2
DOCUMENT_EXTRACTION_MAX_ATTEMPTS=3
DOCUMENT_EXTRACTION_RETRY_DELAY_MS=5000
DOCUMENT_EXTRACTION_JOB_LEASE_MS=120000
DOCUMENT_EXTRACTION_TIMEOUT_MS=120000
# Fail-closed default for staging & production; set to true ONLY for explicit local dev without a malware scanner
DOCUMENT_EXTRACTION_ALLOW_UNSCANNED=false
DOCUMENT_EXTRACTION_ALLOW_UNSCANNED_OVERRIDE=false
DOCUMENT_EXTRACTION_MANUAL_RETRY_COOLDOWN_MS=60000
DOCUMENT_EXTRACTION_MANUAL_RETRY_RATE_WINDOW_MS=900000
DOCUMENT_EXTRACTION_MANUAL_RETRY_RATE_MAX=5
DOCUMENT_EXTRACTION_MAX_DOCX_UNCOMPRESSED_BYTES=20971520
AI_EXTRACTION_MODEL=gemini-3.5-flash

# Module 3: Candidate Intelligence & Job Requirement Analysis Engine
CANDIDATE_INTELLIGENCE_ENABLED=true
CANDIDATE_INTELLIGENCE_WORKER_CONCURRENCY=2
CANDIDATE_INTELLIGENCE_MAX_ATTEMPTS=3
CANDIDATE_INTELLIGENCE_RETRY_DELAY_MS=5000
CANDIDATE_INTELLIGENCE_JOB_LEASE_MS=120000
CANDIDATE_INTELLIGENCE_SEMANTIC_MATCHING_ENABLED=true

# Module 4: Intelligent Interview Blueprint Generator
INTERVIEW_BLUEPRINT_ENABLED=true
INTERVIEW_BLUEPRINT_DEFAULT_DURATION_MINUTES=45
INTERVIEW_BLUEPRINT_WORKER_CONCURRENCY=2
INTERVIEW_BLUEPRINT_MAX_ATTEMPTS=3
INTERVIEW_BLUEPRINT_RETRY_DELAY_MS=5000
INTERVIEW_BLUEPRINT_JOB_LEASE_MS=120000
INTERVIEW_BLUEPRINT_REGENERATE_RATE_WINDOW_MS=900000
INTERVIEW_BLUEPRINT_REGENERATE_RATE_MAX=5
INTERNAL_ORCHESTRATOR_SECRET=change-this-internal-orchestrator-secret

# Module 5: Live AI Interview Orchestration Engine
INTERVIEW_ORCHESTRATOR_ENABLED=true
INTERVIEW_ORCHESTRATOR_MAX_FOLLOW_UPS_PER_QUESTION=2
INTERVIEW_ORCHESTRATOR_THINKING_GRACE_MS=30000
INTERVIEW_ORCHESTRATOR_INACTIVITY_TIMEOUT_MS=300000
INTERVIEW_ORCHESTRATOR_MEMORY_SNAPSHOT_INTERVAL=3
INTERVIEW_ORCHESTRATOR_LLM_TIMEOUT_MS=20000
INTERVIEW_ORCHESTRATOR_REQUIRE_CONSENT=true
INTERVIEW_ORCHESTRATOR_TURN_RATE_WINDOW_MS=60000
INTERVIEW_ORCHESTRATOR_TURN_RATE_MAX=30

# Module 6: AI Interview Evaluation & Reporting Engine
INTERVIEW_EVALUATION_ENABLED=true
INTERVIEW_EVALUATION_WORKER_CONCURRENCY=2
INTERVIEW_EVALUATION_MAX_ATTEMPTS=3
INTERVIEW_EVALUATION_RETRY_DELAY_MS=5000
INTERVIEW_EVALUATION_JOB_LEASE_MS=120000
INTERVIEW_EVALUATION_BATCH_SIZE=3
INTERVIEW_EVALUATION_MIN_COVERAGE_PERCENT=50
INTERVIEW_EVALUATION_EXPOSE_CANDIDATE_SCORES=false
INTERVIEW_EVALUATION_RETRY_RATE_WINDOW_MS=900000
INTERVIEW_EVALUATION_RETRY_RATE_MAX=5

# Module 7: Recruiter Decision Support & Candidate Development Intelligence
DECISION_INTELLIGENCE_ENABLED=true
DECISION_INTELLIGENCE_WORKER_CONCURRENCY=2
DECISION_INTELLIGENCE_MAX_ATTEMPTS=3
DECISION_INTELLIGENCE_RETRY_DELAY_MS=5000
DECISION_INTELLIGENCE_JOB_LEASE_MS=120000
DECISION_INTELLIGENCE_CALIBRATION_MIN_SAMPLES=5

# Optional ClamAV (clamd) engine in addition to the built-in scanner
CLAMAV_HOST=
CLAMAV_PORT=3310
